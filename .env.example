# Every integration is optional: without a key, that piece switches to a labelled fallback
# (rules engine, dated snapshots, browser voice, simulated receipts) and the demo still runs.

# ─── Agent model ────────────────────────────────────────────────
# auto = OpenAI-compatible LLM if LLM_API_KEY is set, else Claude if ANTHROPIC_API_KEY (or the
#        Vercel AI Gateway below) is set, else the deterministic rules engine. Any LLM error falls
#        back to the rules engine with a visible note.
# Values: auto | openai | anthropic | rules
AGENT_PROVIDER=auto
# Older switch, still honoured when AGENT_PROVIDER is empty:
#   offline = rules engine only · claude = Claude only, errors are shown (no fallback) · auto
AGENT_MODE=
# Tool-call rounds per answer
AGENT_MAX_TURNS=8

# Any OpenAI-compatible Chat Completions endpoint. Switching model = changing these lines.
#   Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#   Typhoon:  LLM_BASE_URL=https://api.opentyphoon.ai/v1        (Thai-native, free research API)
#   Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter / Vercel AI Gateway / local Ollama also work.
# Pick LLM_MODEL from the provider's current model list (it must support tool/function calling).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_LABEL=LLM
LLM_TIMEOUT_MS=25000

# Claude via the native Anthropic SDK (optional; never routed through the shim above).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (lower = faster on stage)
AGENT_EFFORT=low
# Optional: send the Claude calls through Vercel AI Gateway instead of the Anthropic API.
# AI_GATEWAY=vercel needs AI_GATEWAY_API_KEY; check the model id in the gateway's model list.
AI_GATEWAY=none
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-opus-5.5

# ─── Auth ───────────────────────────────────────────────────────
# Required for `npm start` (production). Generate one: openssl rand -base64 32
AUTH_SECRET=
# One-tap demo account on /login (set false after the hackathon)
DEMO_LOGIN=true
# true = everyone who taps "demo" is the same demo-user (the stage laptop: U-Bot over MCP acts for
# demo-user). false = each visitor gets their own demo account. Default: false on Vercel, true elsewhere.
# DEMO_SHARED=
# Where email accounts are stored locally (JSON file, git-ignored). With the shared store on
# (KV_REST_API_* / UPSTASH_*) accounts live in Upstash instead, so sign-up works on Vercel.
DATA_DIR=data/runtime

# ─── MCP endpoint for U-Bot (/api/mcp) ──────────────────────────
# Clients send `Authorization: Bearer <key>`. Without a key: open in dev, disabled in production.
# With the key a caller may act for a user (X-UGuard-User); `npm run ubot` reads this same value.
MCP_API_KEY=

# ─── Tokenomist (sponsor) ───────────────────────────────────────
# Without a key every call reads data/fixtures (snapshot/sample, labelled in the UI).
# `npm run snapshot -- ARB WLD AVAX` saves live data as offline fixtures.
TOKENOMIST_API_KEY=
TOKENOMIST_BASE_URL=https://api.tokenomist.ai
# Tokens scored in full when Tokenomist is live (ticker, calendar, Today), at most 12.
# Default: ARB,WLD,AVAX,OP,SUI,APT,TIA,STRK,ZRO,ENA. Fewer = fewer API calls.
# TRACKED_TOKENS=

# ─── Market data, news, odds ────────────────────────────────────
# live = CoinGecko + Fear & Greed + Deribit DVOL · fixture = dated snapshot
MARKET_SOURCE=fixture   # "live" = Hyperliquid prices + CoinGecko volume
# live = GDELT DOC API (no key) · fixture = data/fixtures/news.json (real reporting, dated)
NEWS_SOURCE=fixture
# live = Polymarket Gamma API (no key) · fixture = data/fixtures/odds.json
ODDS_SOURCE=fixture

# ─── ElevenLabs (sponsor) ───────────────────────────────────────
# Without a key the browser's built-in voice reads answers aloud.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 speaks Thai and English
ELEVENLABS_MODEL_ID=eleven_v3
# Speech-to-text for the mic button (Scribe). scribe_v2 also exists; check which your plan has.
ELEVENLABS_STT_MODEL_ID=scribe_v1

# ─── Avalanche (sponsor) ────────────────────────────────────────
# Fuji testnet only. Without a key, approvals create a SIMULATED receipt.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Read the live AVAX balance for this address into the demo portfolio (optional)
WALLET_ADDRESS=
# Avalanche Data API (balances, transactions, contracts for the agent). Works without a key;
# a key from build.avax.network raises the rate limit.
AVALANCHE_DATA_API_KEY=
# AVALANCHE_DATA_API_URL=https://data-api.avax.network

# ─── Paper broker (optional) ─────────────────────────────────────
# local = approved paper orders stay in the app (default)
# alpaca-paper = after the user approves, the order is also sent to an Alpaca *paper* account
#   (free account at alpaca.markets; the URL is hard-coded to paper, there is no live mode).
#   No AI tool can place it: only the user's approval in the app does.
BROKER=local
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Testnet-only demo signer for the on-chain approval receipt. NEVER a mainnet key.
DEMO_PRIVATE_KEY=

# ─── U-Bot (U-topia) ────────────────────────────────────────────
# mock = alerts land in the in-app inbox · webhook = POST replies to UBOT_WEBHOOK_URL
# (adjust the payload in src/lib/ubot.ts once U-topia shares the spec)
UBOT_ADAPTER=mock
UBOT_WEBHOOK_URL=
# Bearer key for inbound /api/ubot/webhook. Required in production (the webhook is off without it).
UBOT_API_KEY=

# ─── Logs ───────────────────────────────────────────────────────
# Run log (one JSON line per agent run / protection receipt) for replaying the stage demo.
LOG_DIR=logs

# ─── Rehearsal ──────────────────────────────────────────────────
# Freeze the clock, e.g. to rehearse the demo-day view the day before. ARB unlocks at
# 13:00 UTC (20:00 Bangkok) on 16 Oct 2026, so the afternoon demo shows it "in a few hours":
# DEMO_NOW=2026-10-16T07:00:00Z
DEMO_NOW=

# ─── Watcher (alerts without pressing a button) ───
# Minutes between automatic checks of every alert rule in a long-running server (`npm start`).
# 0 turns it off. On serverless hosts, call POST /api/watch with "Authorization: Bearer $CRON_SECRET"
# from a cron instead.
WATCH_INTERVAL_MIN=10
# Vercel Cron (vercel.json) calls GET /api/watch with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Bangkok hours when only high-severity alerts go out (equal values turn quiet hours off),
# and the most alerts one user gets per day.
WATCH_QUIET_START=22
WATCH_QUIET_END=7
WATCH_MAX_PER_DAY=5

# Live news: "rss" = Cointelegraph, CoinDesk and Decrypt headlines + the curated snapshot
# NEWS_SOURCE=rss
# Shared store on serverless hosts (Vercel Upstash integration sets these; the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names work too). Needed on Vercel so the
# inbox, proposals and plans are the same in every function.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
